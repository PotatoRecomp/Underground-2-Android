    {0x0DC884CBu, "$JOY_EVENT_FENG_PAD_LEFT$ $JOY_EVENT_FENG_PAD_LEFT_ALTERNATE$  Ganti Kategori^$JOY_EVENT_FENG_PAD_RIGHT_ALTERNATE$ $ICON_SPACER$  Putar Mobil^$JOY_EVENT_FENG_SELECT$ $ICON_SPACER$  Pilih Opsi Terpilih^$JOY_EVENT_FENG_CANCEL$ $ICON_SPACER$  Kembali ke Menu Sebelumnya^"},
    {0x0DD35467u, "Spion Samping"},
