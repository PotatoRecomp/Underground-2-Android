    {0x0F19E56Du, "$JOY_EVENT_FENG_PAD_UP$ $JOY_EVENT_FENG_PAD_UP_ALTERNATE$ Ganti Pilihan^$JOY_EVENT_FENG_PAD_LEFT$ $JOY_EVENT_FENG_PAD_LEFT_ALTERNATE$ Ganti Merek^$JOY_EVENT_FENG_SELECT$ $ICON_SPACER$ Lanjut^$JOY_EVENT_FENG_CANCEL$ $ICON_SPACER$ Kembali ke Menu Sebelumnya^"},
    {0x0F1BB84Du, "Waktu sebagai Pemimpin:"},
    {0x0F4889BDu, "Sekarang kamu sudah punya kendaraan, datanglah ke garasiku. Lokasinya sudah aku kirim ke petamu dan GPS-nya sudah aktif. Oh, dan nggak usah cari balapan, lagi nggak ada apa-apa. Jangan bikin aku nunggu. Sampai ketemu di sana."},
    {0x0F5AE412u, "Butuh dorongan ekstra\077 N2O terkuat di pasaran sekarang tersedia eksklusif di semua Bayview Performance Shops."},
    {0x0F636A00u, "SLOT KOSONG"},
    {0x0F87545Du, "Torsi Maks:"},
    {0x0F9109B2u, "Biar aku kasih info. Semua yang terjadi di dunia balap Bayview lewat aku."},
    {0x0F9109B3u, "Dan kalau kamu belum"},
    {0x0F9109B4u, "Apa pun yang kamu suka, bisa kamu temukan - kalau kamu tahu di mana mencarinya."},
    {0x0F9109B5u, "Drag, drift, sirkuit dan masih banyak lagi. Dunia ini sangat dalam, kita"},
    {0x0F9109B6u, "Tentu saja dengan itu datang kesempatan mendapat uang besar. Dan yang terbaik,"},
    {0x0F9109B7u, "Yang dibutuhkan hanyalah reputasi yang tepat"},
