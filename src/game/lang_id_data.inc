    {0x47597606u, "Opsi Game Quick Race"},
    {0x47ABE874u, "KETENTUAN KESEPAKATAN:^Kontrak selesai setelah memenangkan 5 balapan URL, 3 balapan pilihan sponsor, dan 19 balapan tambahan pilihan pembalap.^^SYARAT PROMOSI:^Bangun mobil yang tampil di 2 sampul DVD.^^BONUS:^Kendaraan gratis dari dealer mobil Bayview."},
    {0x47B276EFu, "Pilih Mode Balapan"},
    {0x47C515D5u, "Terjadi masalah saat mengirim informasi mobilmu. Mau mencoba lagi\077"},
    {0x47CFBEDDu, "Bro! Kru kota sudah selesai malam ini dan jalan ke Coal Harbor West terbuka dan siap untuk balapan. Kabarnya sudah ada pembalap yang berkumpul. Pergi dan lihat."},
    {0x47D572A3u, "Untuk menyesuaikan musik game, pilih Opsi lalu pilih EA GAMES\202 TRAX. Lagu dapat dipratinjau, dimatikan, atau disusun ulang."},
