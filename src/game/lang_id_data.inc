    {0x4B14AF4Eu, "Membatalkan permintaan pertemanan untuk %s ..."},
    {0x4B27846Fu, "Saat berkendara di jalan lurus, rem sekeras mungkin sebelum masuk tikungan. Setelah apex tikungan, injak pedal gas untuk berakselerasi keluar dari tikungan."},
    {0x4B42FBEDu, "Pertandingan Cepat"},
    {0x4B5C9721u, "Sesi game ini tidak lagi tersedia."},
